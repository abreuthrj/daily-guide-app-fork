{
  "name": "daily_guide",
  "version": "1.1.6",
  "private": true,
  "reactNativePermissionsIOS": [
    "Notifications"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:dev": "npm run env:dev && react-native start",
    "start:staging": "npm run env:staging && react-native start",
    "test": "jest",
    "lint": "eslint .",
    "env:dev": "node -e \"const fs=require('fs');fs.writeFileSync('.env', fs.readFileSync('.env.dev'))\"",
    "env:staging": "node -e \"const fs=require('fs');fs.writeFileSync('.env', fs.readFileSync('.env.staging'))\"",
    "build:android": "scripts/build.sh $(node -e \"const v=JSON.parse(require('fs').readFileSync('package.json').toString()).version;console.log(v);\")",
    "postinstall": "react-native setup-ios-permissions && pod-install"
  },
  "dependencies": {
    "@crowdin/crowdin-api-client": "^1.23.1",
    "@invertase/react-native-apple-authentication": "^2.2.2",
    "@react-native-async-storage/async-storage": "^1.18.1",
    "@react-native-firebase/analytics": "^18.2.0",
    "@react-native-firebase/app": "^18.1.0",
    "@react-native-firebase/auth": "^18.1.0",
    "@react-native-firebase/crashlytics": "^18.1.0",
    "@react-native-firebase/messaging": "^18.1.0",
    "@react-native-google-signin/google-signin": "^9.0.2",
    "@react-navigation/native": "^6.1.3",
    "@react-navigation/stack": "^6.3.12",
    "@types/react-native-vector-icons": "^6.4.13",
    "axios": "^1.4.0",
    "react": "18.1.0",
    "react-native": "0.71.6",
    "react-native-date-picker": "^4.2.9",
    "react-native-device-info": "^10.6.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.9.0",
    "react-native-iap": "^12.10.5",
    "react-native-iphone-x-helper": "^1.3.1",
    "react-native-permissions": "^3.8.1",
    "react-native-progress": "^5.0.0",
    "react-native-reanimated": "^3.1.0",
    "react-native-safe-area-context": "^4.5.0",
    "react-native-screens": "^3.20.0",
    "react-native-share": "^9.0.2",
    "react-native-splash-screen": "^3.3.0",
    "react-native-svg": "^13.8.0",
    "react-native-vector-icons": "^9.2.0",
    "react-native-view-shot": "^3.7.0",
    "styled-components": "^5.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/runtime": "^7.12.5",
    "@react-native-community/eslint-config": "^2.0.0",
    "@tsconfig/react-native": "^2.0.3",
    "@types/jest": "^29.2.5",
    "@types/react": "^18.0.26",
    "@types/react-native": "^0.70.8",
    "@types/react-test-renderer": "^18.0.0",
    "@types/styled-components": "^5.1.26",
    "@types/styled-components-react-native": "^5.2.1",
    "babel-jest": "^26.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^7.32.0",
    "jest": "^26.6.3",
    "metro-react-native-babel-preset": "0.72.3",
    "pod-install": "0.1.38",
    "react-native-dotenv": "^3.4.8",
    "react-native-svg-transformer": "^1.0.0",
    "react-test-renderer": "18.1.0",
    "typescript": "^4.9.4"
  },
  "jest": {
    "preset": "react-native"
  }
}
